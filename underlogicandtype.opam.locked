opam-version: "2.0"
name: "underlogicandtype"
version: "dev"
synopsis: "Rocq proofs for Context Types"
description:
  "Mechanization of context types, resource semantics, and soundness."
maintainer: "https://github.com/zhezhouzz/UnderLogicAndType/issues"
authors: "Zhe Zhou"
license: "MIT"
homepage: "https://github.com/zhezhouzz/UnderLogicAndType"
bug-reports: "https://github.com/zhezhouzz/UnderLogicAndType/issues"
depends: [
  "base" {= "v0.16.5" & with-dev-setup}
  "base-bigarray" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "conf-clang" {= "2"}
  "conf-gmp" {= "5"}
  "conf-pkg-config" {= "5"}
  "coq" {= "9.1.0"}
  "coq-core" {= "9.1.0"}
  "coq-hammer" {= "1.3.2+9.1"}
  "coq-hammer-tactics" {= "1.3.2+9.1"}
  "coq-stdlib" {= "9.0.0"}
  "coqide-server" {= "9.1.0"}
  "cppo" {= "1.8.0" & with-dev-setup}
  "csexp" {= "1.5.2" & with-dev-setup}
  "dune" {= "3.23.1"}
  "dune-configurator" {= "3.23.1" & with-dev-setup}
  "jane-street-headers" {= "v0.16.0" & with-dev-setup}
  "jsonrpc" {= "1.27.0" & with-dev-setup}
  "jst-config" {= "v0.16.0" & with-dev-setup}
  "lsp" {= "1.27.0" & with-dev-setup}
  "num" {= "1.6" & with-dev-setup}
  "ocaml" {= "4.14.2"}
  "ocaml-base-compiler" {= "4.14.2"}
  "ocaml-compiler-libs" {= "v0.12.4" & with-dev-setup}
  "ocaml-config" {= "2"}
  "ocaml-options-vanilla" {= "1"}
  "ocamlbuild" {= "0.16.1" & with-dev-setup}
  "ocamlfind" {= "1.9.8"}
  "octavius" {= "1.2.2" & with-dev-setup}
  "parsexp" {= "v0.16.0" & with-dev-setup}
  "ppx_assert" {= "v0.16.0" & with-dev-setup}
  "ppx_base" {= "v0.16.0" & with-dev-setup}
  "ppx_cold" {= "v0.16.0" & with-dev-setup}
  "ppx_compare" {= "v0.16.0" & with-dev-setup}
  "ppx_derivers" {= "1.2.1" & with-dev-setup}
  "ppx_deriving" {= "6.0.3" & with-dev-setup}
  "ppx_enumerate" {= "v0.16.0" & with-dev-setup}
  "ppx_globalize" {= "v0.16.0" & with-dev-setup}
  "ppx_hash" {= "v0.16.0" & with-dev-setup}
  "ppx_here" {= "v0.16.0" & with-dev-setup}
  "ppx_import" {= "1.12.0" & with-dev-setup}
  "ppx_inline_test" {= "v0.16.1" & with-dev-setup}
  "ppx_js_style" {= "v0.16.0" & with-dev-setup}
  "ppx_optcomp" {= "v0.16.0" & with-dev-setup}
  "ppx_sexp_conv" {= "v0.16.0" & with-dev-setup}
  "ppx_yojson_conv" {= "v0.16.0" & with-dev-setup}
  "ppx_yojson_conv_lib" {= "v0.16.0" & with-dev-setup}
  "ppxlib" {= "0.35.0" & with-dev-setup}
  "result" {= "1.5" & with-dev-setup}
  "rocq-core" {= "9.1.0"}
  "rocq-runtime" {= "9.1.0"}
  "rocq-stdlib" {= "9.0.0"}
  "rocq-stdpp" {= "dev.2026-01-23.0.217a887d"}
  "sel" {= "0.8.0" & with-dev-setup}
  "sexplib" {= "v0.16.0" & with-dev-setup}
  "sexplib0" {= "v0.16.0" & with-dev-setup}
  "stdio" {= "v0.16.0" & with-dev-setup}
  "stdlib-shims" {= "0.3.0" & with-dev-setup}
  "time_now" {= "v0.16.0" & with-dev-setup}
  "topkg" {= "1.1.1" & with-dev-setup}
  "uutf" {= "1.0.4" & with-dev-setup}
  "vsrocq-language-server" {= "2.4.3+1" & with-dev-setup}
  "yojson" {= "3.0.0" & with-dev-setup}
  "zarith" {= "1.14"}
]
build: [
  ["rocq" "makefile" "-f" "_CoqProject" "-o" "Makefile"]
  [make "-j%{jobs}%"]
]
dev-repo: "git+https://github.com/zhezhouzz/UnderLogicAndType.git"